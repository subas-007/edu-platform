generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  ADMIN
  EXAMINER
  STUDENT
}

enum MaterialFileType {
  URL
  PDF
  JPEG
  PNG
  DOCX
}

enum MaterialStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum GenerationStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  /// A requested run the student stopped (material_generations only).
  CANCELLED
}

enum MaterialVisibility {
  PRIVATE // visible to uploader (+ staff)
  PUBLISHED // visible to every student
}

enum QuestionType {
  MULTIPLE_CHOICE
  SCENARIO
}

enum QuestionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamMode {
  LEARNING
  EXAM
}

enum ExamPaperStatus {
  DRAFT // examiner is assembling / reviewing the paper
  PUBLISHED // students can enroll and sit it
  CLOSED // no new attempts; results remain
}

enum ExamSessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  /// Display name for certificates / UI. Optional; falls back to the e-mail.
  fullName     String?  @map("full_name")
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  /// Incremented on role change / deactivation to invalidate outstanding access tokens.
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  materials          Material[]
  examSessions       ExamSession[]
  roadmapProgress    RoadmapProgress[]
  auditLogs          AuditLog[]
  examPapers         ExamPaper[]          @relation("PaperCreator")
  enrollments        ExamEnrollment[]
  aiPreference       AiPreference?
  generationRequests MaterialGeneration[]
  brandingUpdates    Branding[]

  @@map("users")
}

enum AiMode {
  LOCAL
  HOSTED
}

/// Which model answers a user's AI requests: the server's free local model, or a hosted
/// provider paid with the user's own API key (stored encrypted, see CredentialCipher).
model AiPreference {
  userId           String   @id @map("user_id") @db.Uuid
  mode             AiMode   @default(LOCAL)
  /// Id from HOSTED_PROVIDERS (fixed list of endpoints); null while unset.
  provider         String?
  model            String?
  /// AES-256-GCM ciphertext; never returned by the API.
  apiKeyCiphertext String?  @map("api_key_ciphertext")
  /// Last characters of the key, for display only.
  apiKeyHint       String?  @map("api_key_hint")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_preferences")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token; the raw token is never stored.
  tokenHash String    @unique @map("token_hash")
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Material {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  /// Opaque storage key for uploads, or the source URL for URL materials.
  fileUrl            String             @map("file_url")
  fileType           MaterialFileType   @map("file_type")
  status             MaterialStatus     @default(QUEUED)
  visibility         MaterialVisibility @default(PRIVATE)
  failureReason      String?            @map("failure_reason")
  /// While PROCESSING, the long step under way (OCR of scanned PDF pages) and how far it is (0..100).
  processingNote     String?            @map("processing_note")
  processingProgress Int?               @map("processing_progress")
  /// 0..1 heuristic used by the roadmap generator.
  complexityScore    Float?             @map("complexity_score")
  /// SHA-256 of the normalised extracted text; identical content reuses existing AI assets.
  contentHash        String?            @map("content_hash")
  /// Set when chunks/flashcards/questions/roadmap were copied from another material (no LLM calls).
  reusedFromId       String?            @map("reused_from_id") @db.Uuid
  /// Flashcard/question/roadmap generation, which runs after the material is READY (chunks embedded).
  generationStatus   GenerationStatus   @default(PENDING) @map("generation_status")
  /// 0..100 while GENERATING.
  generationProgress Int                @default(0) @map("generation_progress")
  generationError    String?            @map("generation_error")
  uploadedById       String             @map("uploaded_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  uploadedBy    User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks        DocumentChunk[]
  flashcards    Flashcard[]
  examQuestions ExamQuestion[]
  examSessions  ExamSession[]
  roadmap       StudyRoadmap?
  generations   MaterialGeneration[]
  reusedFrom    Material?            @relation("MaterialReuse", fields: [reusedFromId], references: [id], onDelete: SetNull)
  reusedBy      Material[]           @relation("MaterialReuse")

  @@index([uploadedById])
  @@index([contentHash])
  @@index([visibility, status])
  @@map("materials")
}

enum AssetKind {
  FLASHCARDS
  QUESTIONS
}

enum GenerationRequestMode {
  REPLACE // regenerate: new set replaces the old one once it exists
  MORE // add items, avoiding ones already there
}

/// A student-requested flashcard or question run (latest one per kind). Student uploads are
/// only stored and indexed; flashcards and questions are generated when the student asks,
/// with the model they pick for that run.
model MaterialGeneration {
  materialId    String                @map("material_id") @db.Uuid
  kind          AssetKind
  /// PENDING = queued, GENERATING = running, then COMPLETED, FAILED or CANCELLED (stopped by the student).
  status        GenerationStatus      @default(PENDING)
  progress      Int                   @default(0)
  error         String?
  engine        AiMode
  /// What ran it, for display ("Qwen3 4B (local)", "Anthropic (Claude) · claude-haiku-5-5").
  engineLabel   String                @map("engine_label")
  mode          GenerationRequestMode
  requestedById String                @map("requested_by") @db.Uuid
  /// New items saved by the finished run.
  added         Int?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requestedBy User     @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@id([materialId, kind])
  @@index([status])
  @@map("material_generations")
}

model DocumentChunk {
  id         String                      @id @default(uuid()) @db.Uuid
  materialId String                      @map("material_id") @db.Uuid
  chunkIndex Int                         @map("chunk_index")
  content    String
  tokenCount Int                         @map("token_count")
  /// Dimension must equal EMBEDDING_DIMENSIONS. HNSW index lives in prisma/sql/vector-index.sql.
  embedding  Unsupported("vector(768)")?

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@map("document_chunks")
}

model Flashcard {
  id            String   @id @default(uuid()) @db.Uuid
  materialId    String   @map("material_id") @db.Uuid
  frontText     String   @map("front_text")
  backText      String   @map("back_text")
  sourceChunkId String?  @map("source_chunk_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("flashcards")
}

model ExamQuestion {
  id            String               @id @default(uuid()) @db.Uuid
  materialId    String               @map("material_id") @db.Uuid
  questionType  QuestionType         @default(MULTIPLE_CHOICE) @map("question_type")
  questionText  String               @map("question_text")
  /// [{ "id": "A", "text": "..." }, ...]
  options       Json
  /// Option id. NEVER serialised to students before feedback is due.
  correctAnswer String               @map("correct_answer")
  explanation   String
  conceptTag    String               @map("concept_tag")
  sourceChunkId String?              @map("source_chunk_id") @db.Uuid
  reviewStatus  QuestionReviewStatus @default(PENDING) @map("review_status")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  material Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  answers  ExamAnswer[]

  @@index([materialId, reviewStatus])
  @@map("exam_questions")
}

model ExamSession {
  id           String            @id @default(uuid()) @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  /// Practice sessions target one material; exam-program sessions target a paper instead.
  materialId   String?           @map("material_id") @db.Uuid
  paperId      String?           @map("paper_id") @db.Uuid
  mode         ExamMode
  status       ExamSessionStatus @default(IN_PROGRESS)
  /// Frozen question set so the exam cannot change mid-attempt.
  questionIds  String[]          @map("question_ids") @db.Uuid
  score        Float?
  correctCount Int?              @map("correct_count")
  diagnostics  Json?
  startedAt    DateTime          @default(now()) @map("started_at")
  expiresAt    DateTime?         @map("expires_at")
  completedAt  DateTime?         @map("completed_at")

  student  User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material Material?    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  paper    ExamPaper?   @relation(fields: [paperId], references: [id], onDelete: Restrict)
  answers  ExamAnswer[]

  @@index([studentId, status])
  @@index([paperId])
  @@map("exam_sessions")
}

/// Ad-hoc question paper assembled by an examiner from the question bank.
model ExamPaper {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  description     String          @default("")
  status          ExamPaperStatus @default(DRAFT)
  durationMinutes Int             @map("duration_minutes")
  maxAttempts     Int             @default(1) @map("max_attempts")
  /// Ordered, frozen selection of APPROVED bank questions.
  questionIds     String[]        @map("question_ids") @db.Uuid
  /// Resources the paper was drawn from (for display / filtering).
  materialIds     String[]        @map("material_ids") @db.Uuid
  createdById     String          @map("created_by") @db.Uuid
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  createdBy   User             @relation("PaperCreator", fields: [createdById], references: [id], onDelete: Restrict)
  enrollments ExamEnrollment[]
  sessions    ExamSession[]

  @@index([status])
  @@map("exam_papers")
}

model ExamEnrollment {
  id         String   @id @default(uuid()) @db.Uuid
  paperId    String   @map("paper_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
  @@index([studentId])
  @@map("exam_enrollments")
}

model ExamAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  selectedAnswer String   @map("selected_answer")
  isCorrect      Boolean  @map("is_correct")
  answeredAt     DateTime @default(now()) @map("answered_at")

  session  ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId, isCorrect])
  @@map("exam_answers")
}

model StudyRoadmap {
  id             String   @id @default(uuid()) @db.Uuid
  materialId     String   @unique @map("material_id") @db.Uuid
  /// [{ "id": "m1", "title": "...", "summary": "...", "estimatedMinutes": 30, "chunkIndexes": [0,1] }]
  milestones     Json
  estimatedHours Float    @map("estimated_hours")
  createdAt      DateTime @default(now()) @map("created_at")

  material Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  progress RoadmapProgress[]

  @@map("study_roadmaps")
}

model RoadmapProgress {
  id                  String   @id @default(uuid()) @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  roadmapId           String   @map("roadmap_id") @db.Uuid
  completedMilestones String[] @map("completed_milestones")
  updatedAt           DateTime @updatedAt @map("updated_at")

  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roadmap StudyRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([studentId, roadmapId])
  @@map("roadmap_progress")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

/// Background presets for the site theme (see src/branding/palette.ts).
enum SurfaceTheme {
  MIDNIGHT
  GRAPHITE
  PLUM
  PINE
  ESPRESSO
}

/// The site's name, logo and colours, set by an administrator. A single row (id 1); when it is
/// missing the defaults apply.
model Branding {
  id            Int          @id @default(1)
  appName       String       @map("app_name")
  /// #rrggbb; the shade scales are computed from it.
  accentColor   String       @map("accent_color")
  surface       SurfaceTheme @default(MIDNIGHT)
  /// PNG or JPEG (checked by magic bytes), at most 512 KB.
  logo          Bytes?
  logoMimeType  String?      @map("logo_mime_type")
  logoUpdatedAt DateTime?    @map("logo_updated_at")
  updatedById   String?      @map("updated_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("branding")
}
