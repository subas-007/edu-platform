NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5432/edu_platform?schema=public
REDIS_URL=redis://:edu_dev_redis@localhost:6379

# Comma-separated list of browser origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3005

# ES256 key pair, base64-encoded PEM. Generate with: npm run keys:generate
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=20971520

# Local model (free for students): Qwen3 4B in Ollama, an OpenAI-compatible server.
# Install Ollama, then build it with:  npm run llm:setup   (measure: npm run llm:bench)
# (any OpenAI-compatible endpoint works: colibri via npm run llm:start, vLLM, LM Studio, OpenAI…)
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Ollama ignores the key, but the OpenAI client requires a non-empty value
LLM_API_KEY=ollama
LLM_CHAT_MODEL=edu-chat
# Name students see for the local model (defaults to LLM_CHAT_MODEL)
LLM_LOCAL_LABEL=Qwen3 4B (local)
# json_object = send response_format (Ollama, OpenAI, vLLM); prompt = servers that reject it (colibri)
LLM_JSON_MODE=json_object
# Per local call: ~40 s on a CPU laptop; 5 min cap, one retry
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=1
# Hosted models: students may use their own provider API key (Settings → AI model). Their keys are
# encrypted with this 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to offer only the local model. Changing it makes saved keys unreadable (students re-enter them).
LLM_CREDENTIALS_KEY=
# local = embed in-process with transformers.js (same for every chat model);
# api = an OpenAI-compatible /embeddings endpoint (EMBEDDING_BASE_URL, else LLM_BASE_URL)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# local provider: fp32 reproduces Ollama's nomic-embed-text vectors exactly; weights cached here (~520 MB)
EMBEDDING_LOCAL_DTYPE=fp32
MODEL_CACHE_DIR=./.cache/models
# Must match vector(N) in prisma/schema.prisma — changing it needs a migration + re-ingest
EMBEDDING_DIMENSIONS=768
# nomic-embed-text expects these task prefixes; leave empty for OpenAI models
EMBEDDING_DOCUMENT_PREFIX=search_document:
EMBEDDING_QUERY_PREFIX=search_query:
# Cosine-similarity floor for tutor retrieval (nomic scores run higher than OpenAI's; ~0.3 for OpenAI)
TUTOR_MIN_SIMILARITY=0.5
# One tutor answer (no retries): length cap and time limit. The timeout must stay below the web's
# API_PROXY_TIMEOUT_MS (apps/web/.env.local).
# Passages retrieved per question (~500 tokens each). On the local model only their most relevant
# sentences are sent, TUTOR_CONTEXT_TOKENS of them (0 = whole passages); hosted models get whole passages.
TUTOR_TOP_K=6
TUTOR_CONTEXT_TOKENS=1200
# Earlier chat messages the local model re-reads with each question (hosted models get 6)
TUTOR_HISTORY_MESSAGES=4
TUTOR_MAX_TOKENS=400
TUTOR_TIMEOUT_MS=180000
# While a student waits, background generation cancels its local model call and repeats it afterwards
# (one local model serves both). Set false if the local server handles parallel requests well (GPU).
TUTOR_PRIORITY=true
# Starting estimate for the local tutor's progress bar; replaced by the measured speed after one answer
TUTOR_READ_TOKENS_PER_SEC=85
# Flashcard/question generation samples this many 3-chunk sections (2 model calls each, ~40 s per local
# call on a CPU laptop). The second value applies to students using their own hosted model.
GENERATION_MAX_BATCHES=6
GENERATION_MAX_BATCHES_HOSTED=10

# Used once by `npm run db:seed` to bootstrap the first administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
