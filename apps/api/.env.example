NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5432/edu_platform?schema=public
REDIS_URL=redis://:edu_dev_redis@localhost:6379

# Comma-separated list of browser origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3005

# ES256 key pair, base64-encoded PEM. Generate with: npm run keys:generate
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=20971520

# Default: local LLM via colibri (Qwen3.6-35B-A3B), an OpenAI-compatible server.
# Start it tuned for this app with:  npm run llm:start   (scripts/start-llm.ps1; measure: npm run llm:bench)
# (any OpenAI-compatible endpoint works — OpenAI, Azure OpenAI, vLLM, LM Studio, Ollama…)
LLM_BASE_URL=http://127.0.0.1:8000/v1
# colibri ignores the key, but the OpenAI client requires a non-empty value
LLM_API_KEY=colibri
LLM_CHAT_MODEL=qwen3.6-colibri
# json_object = send response_format (OpenAI, Ollama, vLLM); prompt = servers that reject it (colibri)
LLM_JSON_MODE=prompt
# CPU inference: ~2 min to read a 1.4k-token prompt + ~5 tokens/s writing; 15 min cap per call, one retry
LLM_TIMEOUT_MS=900000
LLM_MAX_RETRIES=1
# local = embed in-process with transformers.js (colibri has no /embeddings endpoint);
# api = an OpenAI-compatible /embeddings endpoint (EMBEDDING_BASE_URL, else LLM_BASE_URL)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# local provider: fp32 reproduces Ollama's nomic-embed-text vectors exactly; weights cached here (~520 MB)
EMBEDDING_LOCAL_DTYPE=fp32
MODEL_CACHE_DIR=./.cache/models
# Must match vector(N) in prisma/schema.prisma — changing it needs a migration + re-ingest
EMBEDDING_DIMENSIONS=768
# nomic-embed-text expects these task prefixes; leave empty for OpenAI models
EMBEDDING_DOCUMENT_PREFIX=search_document:
EMBEDDING_QUERY_PREFIX=search_query:
# Cosine-similarity floor for tutor retrieval (nomic scores run higher than OpenAI's; ~0.3 for OpenAI)
TUTOR_MIN_SIMILARITY=0.5
# One tutor answer (no retries): length cap and time limit. The timeout must stay below the web's
# API_PROXY_TIMEOUT_MS (apps/web/.env.local).
# Passages read per question (~500 tokens each; reading dominates on CPU)
TUTOR_TOP_K=4
TUTOR_MAX_TOKENS=400
TUTOR_TIMEOUT_MS=600000
# Flashcard/question generation samples this many 3-chunk sections (2 LLM calls each, ~4-7 min per call
# on CPU with colibri via llm:start): 3 ≈ 40 min per upload. Use 10 with a GPU or hosted model.
GENERATION_MAX_BATCHES=3

# Used once by `npm run db:seed` to bootstrap the first administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
