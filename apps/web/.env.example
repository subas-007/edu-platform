# Where the Next.js server proxies /api/v1/* (server-side only, never exposed to the browser)
API_INTERNAL_URL=http://localhost:4000
# PUBLIC key only (base64 PEM) — the web tier can verify tokens but never mint them
JWT_PUBLIC_KEY_B64=

# Must exceed the API TUTOR_TIMEOUT_MS (600000 with the slow local model)
API_PROXY_TIMEOUT_MS=660000
